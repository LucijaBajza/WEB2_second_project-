<!DOCTYPE html>
<html lang="hr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Demonstracija ranjivosti</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<main class="container">

  <header class="page-header">
    <h1>Demonstracija ranjivosti</h1>
    <p>
      Isprobajte SQL Injection i CSRF napade.
    </p>
  </header>

  <% if (notice) { %>
  <div class="notice <%= noticeType || '' %>" role="status">
    <%= notice %>
  </div>
<% } %>

  <!-- PRIJAVLJENI KORISNIK -->
  <% if (currentUser) { %>
    <section class="status-row">
      <span>
        Prijavljeni ste kao <strong><%= currentUser.username %></strong> (ID: <%= currentUser.id %>)
      </span>

      <form action="/logout" method="POST">
        <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
        <button type="submit" class="btn-secondary">Odjava</button>
      </form>
    </section>
  <% } else { %>
    <div class="notice warning">
      Trenutačno niste prijavljeni. Prijavite se u SQL Injection dijelu kako biste mogli isprobati CSRF.
    </div>
  <% } %>

  <!-- SQL INJECTION -->
  <section>
    <h2>1. SQL Injection</h2>

    <form action="/demo" method="POST">
      <label class="checkbox-row">
        <input
          type="checkbox"
          name="sqlInjectionEnabled"
          <%= sqlInjectionEnabled ? 'checked' : '' %>
        >
        <span>Uključi SQL Injection ranjivost</span>
      </label>

      <p class="muted">
        Prijava provjerava korisničko ime i lozinku u bazi.
        Kada je ranjivost uključena, unos se izravno umeće u SQL upit.
        Kada je isključena, koristi se parametrizirani upit.
      </p>

      <div class="form-row">
        <label>
          <span>Korisničko ime</span>
          <input
            type="text"
            name="username"
            value="<%= username %>"
            placeholder="Npr. admin"
            autocomplete="off"
            required
          >
        </label>

        <label>
          <span>Lozinka</span>
          <input
            type="password"
            name="password"
            placeholder="Unesi lozinku"
            autocomplete="off"
            required
          >
        </label>
      </div>

      <p class="hint">
        <strong>Napad:</strong> U korisničko ime unesite <code>' OR '1'='1' --</code>, lozinka može biti bilo što.<br>
        <strong>Obična prijava:</strong> Na dnu stranice prikazani su korisnički računi. Za korisničko ime unesite neko od navedenih u tablici, 
        a lozinka je korisnickoime123. Primjer: <code>ana / ana123.</code>
      </p>

      <button type="submit">Prijavi se / Pokreni napad</button>
    </form>
  </section>

  <!-- REZULTAT SQL INJECTIONA -->
  <% if (loginResult || sqlPreview || databaseError) { %>
    <section aria-live="polite">
      <h2>Rezultat SQL Injectiona</h2>

      <% if (databaseError) { %>
        <div class="notice error">
          <strong>Pogreška:</strong> <%= databaseError %>
        </div>
      <% } else if (loginResult && loginResult.success) { %>
        <div class="notice success">
          Prijava je uspjela.
        </div>

        <table>
          <thead>
            <tr>
              <th>ID</th>
              <th>Korisničko ime</th>
            </tr>
          </thead>
          <tbody>
            <% loginResult.users.forEach((user) => { %>
              <tr>
                <td><%= user.id %></td>
                <td><%= user.username %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div class="notice error">
          Prijava nije uspjela. Upit nije vratio nijednog korisnika.
        </div>
      <% } %>

      <% if (sqlPreview) { %>
        <h3>SQL upit</h3>
        <p>Prikazan je SQL upit koji je izvršen.</p>
        <pre><code><%= sqlPreview %></code></pre>
      <% } %>
    </section>
  <% } %>

  <!-- CSRF -->
  <section>
    <h2>2. Cross-Site Request Forgery (CSRF)</h2>

    <form action="/csrf-mode" method="POST" id="csrf-mode-form">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>">

      <label class="checkbox-row <%= (!currentUser && csrfVulnerabilityEnabled) ? 'checkbox-disabled' : '' %>">
        <input
          type="checkbox"
          name="csrfVulnerabilityEnabled"
          onchange="this.form.submit()"
          <%= csrfVulnerabilityEnabled === true ? 'checked' : '' %>
          <%= (!currentUser && csrfVulnerabilityEnabled) ? 'disabled' : '' %>
        >
        <span>Uključi CSRF ranjivost</span>
      </label>
    </form>

    <p class="muted">
      Napadačka stranica šalje zahtjev za brisanje računa u ime prijavljenog korisnika dok preglednik automatski prilaže cookie.
    </p>    

    <% if (currentUser) { %>
      <% if (attackerLink) { %>
        <p>
          <a
            href="<%= attackerLink %>"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
          >
            Otvori napadačku stranicu
          </a>
        </p>
      <% } else { %>
        <div class="notice warning">
          Nije postavljen <code>ATTACKER_URL</code>. Na Renderu objavi mapu <code>attacker-site</code> i dodaj njezin URL u varijablu <code>ATTACKER_URL</code>.
        </div>
      <% } %>
    <% } else { %>
      <div class="notice warning">
        Za testiranje CSRF napada prvo se prijavite u SQL Injection dijelu.
      </div>
    <% } %>
  </section>

  <!-- KORISNICI U BAZI -->
  <section>
    <h2>Trenutačni korisnički računi u bazi</h2>

    <p class="muted">
      Osvježite stranicu nakon napada kako biste vidjeli je li račun obrisan.
    </p>

    <% if (usersError) { %>
      <div class="notice"><%= usersError %></div>
    <% } else if (users.length === 0) { %>
      <div class="notice">U tablici users nema korisnika.</div>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Korisničko ime</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach((user) => { %>
            <tr>
              <td><%= user.id %></td>
              <td><%= user.username %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>

</main>

</body>
</html>